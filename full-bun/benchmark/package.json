{
  "name": "benchmark",
  "type": "module",
  "private": true,
  "scripts": {
    "bench": "bun run run.ts",
    "bench:bun": "bun run run.ts --only bun",
    "bench:vite": "bun run run.ts --only vite",
    "bench:quick": "bun run run.ts --duration 5 --connections 20 --samples 10"
  },
  "dependencies": {
    "autocannon": "^8.0.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/bun": "latest"
  }
}
